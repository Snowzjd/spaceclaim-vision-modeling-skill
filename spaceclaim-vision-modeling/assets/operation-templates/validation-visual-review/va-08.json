{
  "$schema": "../../../references/operation-template.schema.json",
  "operation_id": "validation_visual_review.measure-body-bounding-box",
  "template_version": "0.1.0",
  "contract_version": 1,
  "status": "candidate",
  "stage": "validation_visual_review",
  "purpose": "Measure one current body's bounding box in a declared frame and unit, optionally comparing it with expected bounds.",
  "trigger": "Use when the current body, frame, unit, and any expected bounding-box tolerance are explicit.",
  "inputs": [
    {
      "name": "root",
      "type": "SpaceClaim.Api.V21.Part",
      "description": "Live current document root Part.",
      "required": true
    },
    {
      "name": "body",
      "type": "SpaceClaim.Api.V21.DesignBody",
      "description": "Live current direct child body to measure.",
      "required": true
    },
    {
      "name": "frame",
      "type": "enum(world|global|identity) or SpaceClaim.Api.V21.Matrix",
      "description": "World/global/identity selects Matrix.Identity; otherwise a supplied Matrix is passed to GetBoundingBox.",
      "required": true
    },
    {
      "name": "unit",
      "type": "enum(mm|m|in)",
      "description": "Canonical output length unit; aliases are normalized by the action.",
      "required": true
    },
    {
      "name": "tolerance",
      "type": "nonnegative number",
      "description": "Optional absolute tolerance in the selected unit for expected_bbox comparison.",
      "required": false
    },
    {
      "name": "expected_bbox",
      "type": "number[6]",
      "description": "Optional [min_x,min_y,min_z,max_x,max_y,max_z] in the selected unit.",
      "required": false
    }
  ],
  "preconditions": [
    "root and body resolve to the live current root Part and direct child body.",
    "frame is a supported world name or Matrix, and unit is mm, m, or in."
  ],
  "outputs": [
    {
      "name": "action_id",
      "type": "string",
      "description": "Literal validation action identity emitted by the script.",
      "required": true
    },
    {
      "name": "status",
      "type": "enum(passed|failed|needs_manual_review)",
      "description": "Action status from the script result; no status is inferred when execution is unavailable.",
      "required": true
    },
    {
      "name": "geometry_modified",
      "type": "boolean",
      "description": "Always false for this read-only action.",
      "required": true
    },
    {
      "name": "gui_interaction",
      "type": "boolean",
      "description": "Always false; the action does not drive the GUI.",
      "required": true
    },
    {
      "name": "runtime_claim",
      "type": "boolean",
      "description": "Always false; the result does not by itself promote runtime evidence.",
      "required": true
    },
    {
      "name": "validation_boundary",
      "type": "string",
      "description": "Read-only current-root measurement/check boundary reported by the action.",
      "required": true
    },
    {
      "name": "body",
      "type": "SpaceClaim.Api.V21.DesignBody",
      "description": "The validated current body.",
      "required": true
    },
    {
      "name": "frame",
      "type": "string",
      "description": "world for a named world frame, or supplied for a Matrix frame.",
      "required": true
    },
    {
      "name": "unit",
      "type": "enum(mm|m|in)",
      "description": "Canonical unit used for the bounds.",
      "required": true
    },
    {
      "name": "bbox",
      "type": "number[6]",
      "description": "Finite ordered bounds in the selected frame/unit.",
      "required": true
    },
    {
      "name": "bbox_min",
      "type": "number[3]",
      "description": "Minimum bound in the selected frame/unit.",
      "required": true
    },
    {
      "name": "bbox_max",
      "type": "number[3]",
      "description": "Maximum bound in the selected frame/unit.",
      "required": true
    },
    {
      "name": "expected_bbox",
      "type": "number[6]",
      "description": "Normalized expected bounds when supplied.",
      "required": false
    },
    {
      "name": "tolerance",
      "type": "nonnegative number",
      "description": "Applied comparison tolerance when expected_bbox is supplied.",
      "required": false
    },
    {
      "name": "matches",
      "type": "boolean",
      "description": "Whether bbox agrees with expected_bbox within tolerance.",
      "required": false
    }
  ],
  "postconditions": [
    "ATOMIC_OUTPUT.bbox, bbox_min, and bbox_max are finite ordered bounds for body in the requested frame/unit.",
    "No body transform or geometry mutation is performed."
  ],
  "implementation": {
    "mode": "spaceclaim_scscript",
    "primary_artifact": "spaceclaim-vision-modeling/assets/operation-templates/validation-visual-review/actions/va-08.scscript",
    "target_environment": "SpaceClaim V21 / IronPython 2.7 action wrapper with ATOMIC_INPUT/ATOMIC_OUTPUT; runtime execution remains not_tested in this candidate.",
    "topology_effect": "none",
    "determinism": "deterministic",
    "notes": "Candidate exact artifact is bound below; consult the exact-version evidence layers for tested variants. Adapt guidance body_reference/coordinate_frame to ATOMIC_INPUT={root, body, frame, unit, tolerance?:..., expected_bbox?:...}; do not dispatch guidance-only coordinate_frame or bounding_box_record keys."
  },
  "semantic_selection": {
    "required": true,
    "criteria": [
      "bounding_box"
    ],
    "ambiguity_checks": [
      "Resolve the declared target from its supplied identity and semantic properties; do not use arbitrary BodyN/FaceN aliases or return order.",
      "If the target is not unique or the current topology/view cannot be observed, return needs_manual_review and do not continue."
    ],
    "topology_refresh": "Not applicable; this operation does not mutate model topology."
  },
  "failure_modes": [
    {
      "failure_id": "target_unresolved",
      "condition": "The declared target, scope, or view identity is missing or ambiguous.",
      "detection": "The supplied identity does not resolve to exactly one current target.",
      "safe_state": "No validation action is performed and no pass claim is emitted."
    },
    {
      "failure_id": "observation_unavailable",
      "condition": "The required API, host path, controller gesture, or visible state cannot be observed.",
      "detection": "The adapter or controller reports unsupported/blocked/unknown state.",
      "safe_state": "Preserve the current document/view and return needs_manual_review or not_tested."
    }
  ],
  "recovery": [
    {
      "failure_id": "target_unresolved",
      "action": "Strengthen the target identity or stop for manual review; do not substitute a numbered alias.",
      "clean_rerun_required": false
    },
    {
      "failure_id": "observation_unavailable",
      "action": "Use only a verified equivalent control/API or return needs_manual_review; do not repeat an unsupported gesture.",
      "clean_rerun_required": false
    }
  ],
  "validation": [
    {
      "check": "Candidate identity and schema shape",
      "method": "Validate this object against operation-template.schema.json and compare its operation ID with the catalog slug.",
      "expected": "The object is schema-valid, candidate-only, and declares one independent validation_visual_review action.",
      "evidence_layer": "design_only"
    },
    {
      "check": "Guidance/refusal binding",
      "method": "Compare this contract's canonical ATOMIC_INPUT/ATOMIC_OUTPUT fields with the linked action artifact and keep any conceptual guidance-to-script adaptation explicit.",
      "expected": "Canonical live-object/unit/frame fields match the action boundary; guidance-only aliases are not dispatched without an adapter.",
      "evidence_layer": "design_only"
    },
    {
      "check": "Action-specific observation",
      "method": "Execute the exact linked .scscript with one injected ATOMIC_INPUT only after target identity and evidence gates pass.",
      "expected": "ATOMIC_OUTPUT.bbox, bbox_min, and bbox_max are finite ordered bounds for body in the requested frame/unit.",
      "evidence_layer": "spaceclaim_execution"
    }
  ],
