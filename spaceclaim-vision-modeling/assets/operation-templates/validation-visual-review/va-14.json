{
  "$schema": "../../../references/operation-template.schema.json",
  "operation_id": "validation_visual_review.measure-conical-face",
  "template_version": "0.1.0",
  "contract_version": 1,
  "status": "candidate",
  "stage": "validation_visual_review",
  "purpose": "Measure a current conical face's declared half/full angle, axis, and trimmed-face bounding-box projected span.",
  "trigger": "Use when a current cone face, unit, and angle convention are explicit; preserve manual review for unresolved span precision.",
  "inputs": [
    {
      "name": "root",
      "type": "SpaceClaim.Api.V21.Part",
      "description": "Live current document root Part.",
      "required": true
    },
    {
      "name": "body",
      "type": "SpaceClaim.Api.V21.DesignBody",
      "description": "Live current direct child body owning face.",
      "required": true
    },
    {
      "name": "face",
      "type": "SpaceClaim.Api.V21.DesignFace",
      "description": "Live current face expected to expose V21 Cone geometry.",
      "required": true
    },
    {
      "name": "unit",
      "type": "enum(mm|m|in)",
      "description": "Canonical cone span output unit.",
      "required": true
    },
    {
      "name": "angle_mode",
      "type": "enum(half|full)",
      "description": "Explicit half-angle or full-angle interpretation; omitted input returns needs_manual_review.",
      "required": false
    }
  ],
  "preconditions": [
    "root/body/face resolve to one current root-scoped face and unit is mm, m, or in.",
    "angle_mode is explicit for success and the face exposes V21 Cone geometry and Frame.DirZ."
  ],
  "outputs": [
    {
      "name": "action_id",
      "type": "string",
      "description": "Literal validation action identity emitted by the script.",
      "required": true
    },
    {
      "name": "status",
      "type": "enum(passed|failed|needs_manual_review)",
      "description": "Action status from the script result; no status is inferred when execution is unavailable.",
      "required": true
    },
    {
      "name": "geometry_modified",
      "type": "boolean",
      "description": "Always false for this read-only action.",
      "required": true
    },
    {
      "name": "gui_interaction",
      "type": "boolean",
      "description": "Always false; the action does not drive the GUI.",
      "required": true
    },
    {
      "name": "runtime_claim",
      "type": "boolean",
      "description": "Always false; the result does not by itself promote runtime evidence.",
      "required": true
    },
    {
      "name": "validation_boundary",
      "type": "string",
      "description": "Read-only current-root measurement/check boundary reported by the action.",
      "required": true
    },
    {
      "name": "body",
      "type": "SpaceClaim.Api.V21.DesignBody",
      "description": "The validated current body.",
      "required": true
    },
    {
      "name": "face",
      "type": "SpaceClaim.Api.V21.DesignFace",
      "description": "The validated current face.",
      "required": true
    },
    {
      "name": "analytic_type",
      "type": "string",
      "description": "Observed underlying type on a successful or partially observed Cone check.",
      "required": false
    },
    {
      "name": "angle",
      "type": "number",
      "description": "Cone angle in angle_unit under the declared angle_mode when measured.",
      "required": false
    },
    {
      "name": "angle_unit",
      "type": "string",
      "description": "Unit deg when the analytic angle is returned.",
      "required": false
    },
    {
      "name": "angle_mode",
      "type": "enum(half|full)",
      "description": "Normalized angle convention when an angle result is returned.",
      "required": false
    },
    {
      "name": "axis",
      "type": "number[3]",
      "description": "Normalized Cone.Frame.DirZ axis on a successful axis observation.",
      "required": false
    },
    {
      "name": "span",
      "type": "nonnegative number",
      "description": "Scalar axis-projection length of the current trimmed-face bounding box in span_unit when measured.",
      "required": false
    },
    {
      "name": "span_unit",
      "type": "enum(mm|m|in)",
      "description": "Canonical span unit when span is returned.",
      "required": false
    },
    {
      "name": "span_method",
      "type": "string",
      "description": "trimmed-face-bounding-box-axis-projection when span is returned.",
      "required": false
    },
    {
      "name": "span_exact",
      "type": "boolean",
      "description": "On a measured result, true only for axis-aligned projection; arbitrary-axis/rotated spans require manual review.",
      "required": false
    },
    {
      "name": "unit",
      "type": "enum(mm|m|in)",
      "description": "Canonical unit echoed on a manual-review branch when angle or axis was only partially observed.",
      "required": false
    },
    {
      "name": "needs_manual_review",
      "type": "boolean",
      "description": "Present when angle convention/type/axis/API/span precision is unresolved.",
      "required": false
    },
    {
      "name": "reason",
      "type": "string",
      "description": "Manual-review reason when present.",
      "required": false
    }
  ],
  "postconditions": [
    "The Cone half-angle is converted to the declared angle_mode and axis is read from Cone.Frame.DirZ.",
    "span is the scalar length of a bbox axis projection; arbitrary-axis projection returns needs_manual_review, not an exact trim-boundary claim."
  ],
  "implementation": {
    "mode": "spaceclaim_scscript",
    "primary_artifact": "spaceclaim-vision-modeling/assets/operation-templates/validation-visual-review/actions/va-14.scscript",
    "target_environment": "SpaceClaim V21 / IronPython 2.7 action wrapper with ATOMIC_INPUT/ATOMIC_OUTPUT; runtime execution remains not_tested in this candidate.",
    "topology_effect": "none",
    "determinism": "deterministic",
    "notes": "Candidate exact artifact is bound below; consult the exact-version evidence layers for tested variants. Adapt guidance conical_face/angle_convention to ATOMIC_INPUT={root, body, face, unit, angle_mode?:...}; angle_convention is not a script dispatch key. The script preserves the axis-aligned span precision boundary."
  },
  "semantic_selection": {
    "required": true,
    "criteria": [
      "geometry_type",
      "normal",
      "topology"
    ],
    "ambiguity_checks": [
      "Resolve the declared target from its supplied identity and semantic properties; do not use arbitrary BodyN/FaceN aliases or return order.",
      "If the target is not unique or the current topology/view cannot be observed, return needs_manual_review and do not continue."
    ],
    "topology_refresh": "Not applicable; this operation does not mutate model topology."
  },
  "failure_modes": [
    {
      "failure_id": "target_unresolved",
      "condition": "The declared target, scope, or view identity is missing or ambiguous.",
      "detection": "The supplied identity does not resolve to exactly one current target.",
      "safe_state": "No validation action is performed and no pass claim is emitted."
    },
    {
      "failure_id": "observation_unavailable",
      "condition": "The required API, host path, controller gesture, or visible state cannot be observed.",
      "detection": "The adapter or controller reports unsupported/blocked/unknown state.",
      "safe_state": "Preserve the current document/view and return needs_manual_review or not_tested."
    }
  ],
  "recovery": [
    {
      "failure_id": "target_unresolved",
      "action": "Strengthen the target identity or stop for manual review; do not substitute a numbered alias.",
      "clean_rerun_required": false
    },
    {
      "failure_id": "observation_unavailable",
      "action": "Use only a verified equivalent control/API or return needs_manual_review; do not repeat an unsupported gesture.",
      "clean_rerun_required": false
    }
  ],
  "validation": [
    {
      "check": "Candidate identity and schema shape",
      "method": "Validate this object against operation-template.schema.json and compare its operation ID with the catalog slug.",
      "expected": "The object is schema-valid, candidate-only, and declares one independent validation_visual_review action.",
      "evidence_layer": "design_only"
    },
    {
      "check": "Guidance/refusal binding",
      "method": "Compare this contract's canonical ATOMIC_INPUT/ATOMIC_OUTPUT fields with the linked action artifact and keep any conceptual guidance-to-script adaptation explicit.",
      "expected": "Canonical live-object/unit/frame fields match the action boundary; guidance-only aliases are not dispatched without an adapter.",
      "evidence_layer": "design_only"
    },
    {
      "check": "Action-specific observation",
      "method": "Execute the exact linked .scscript with one injected ATOMIC_INPUT only after target identity and evidence gates pass.",
      "expected": "The Cone half-angle is converted to the declared angle_mode and axis is read from Cone.Frame.DirZ.",
      "evidence_layer": "spaceclaim_execution"
    }
