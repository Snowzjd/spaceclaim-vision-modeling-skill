{
  "$schema": "../../../references/operation-template.schema.json",
  "operation_id": "validation_visual_review.measure-toroidal-fillet-radius",
  "template_version": "0.1.0",
  "contract_version": 1,
  "status": "candidate",
  "stage": "validation_visual_review",
  "purpose": "Read a current toroidal face's minor radius and report only a caller-declared fillet association.",
  "trigger": "Use when the current torus face and unit are resolved and any intended fillet relation is explicitly declared.",
  "inputs": [
    {
      "name": "root",
      "type": "SpaceClaim.Api.V21.Part",
      "description": "Live current document root Part.",
      "required": true
    },
    {
      "name": "body",
      "type": "SpaceClaim.Api.V21.DesignBody",
      "description": "Live current direct child body owning face.",
      "required": true
    },
    {
      "name": "face",
      "type": "SpaceClaim.Api.V21.DesignFace",
      "description": "Live current face expected to expose V21 Torus geometry.",
      "required": true
    },
    {
      "name": "unit",
      "type": "enum(mm|m|in)",
      "description": "Canonical toroidal radius output unit.",
      "required": true
    },
    {
      "name": "fillet_relation",
      "type": "string",
      "description": "Optional caller-declared association token; absent or unrecognized association yields needs_manual_review, and no relation is inferred.",
      "required": false
    }
  ],
  "preconditions": [
    "root/body/face resolve to one current root-scoped face, unit is canonical, and the caller supplies any intended fillet relation declaration."
  ],
  "outputs": [
    {
      "name": "action_id",
      "type": "string",
      "description": "Literal validation action identity emitted by the script.",
      "required": true
    },
    {
      "name": "status",
      "type": "enum(passed|failed|needs_manual_review)",
      "description": "Action status from the script result; no status is inferred when execution is unavailable.",
      "required": true
    },
    {
      "name": "geometry_modified",
      "type": "boolean",
      "description": "Always false for this read-only action.",
      "required": true
    },
    {
      "name": "gui_interaction",
      "type": "boolean",
      "description": "Always false; the action does not drive the GUI.",
      "required": true
    },
    {
      "name": "runtime_claim",
      "type": "boolean",
      "description": "Always false; the result does not by itself promote runtime evidence.",
      "required": true
    },
    {
      "name": "validation_boundary",
      "type": "string",
      "description": "Read-only current-root measurement/check boundary reported by the action.",
      "required": true
    },
    {
      "name": "body",
      "type": "SpaceClaim.Api.V21.DesignBody",
      "description": "The validated current body.",
      "required": true
    },
    {
      "name": "face",
      "type": "SpaceClaim.Api.V21.DesignFace",
      "description": "The validated current face.",
      "required": true
    },
    {
      "name": "analytic_type",
      "type": "string",
      "description": "Observed underlying type when the toroidal check is sufficiently observed.",
      "required": false
    },
    {
      "name": "minor_radius",
      "type": "positive number",
      "description": "Torus.MinorRadius in radius_unit when the toroidal radius is measured; this is the only radius measured by the action.",
      "required": false
    },
    {
      "name": "radius_unit",
      "type": "enum(mm|m|in)",
      "description": "Canonical radius unit when minor_radius is returned.",
      "required": false
    },
    {
      "name": "association_status",
      "type": "enum(not_verified|declared)",
      "description": "Caller-declared association state when the Torus.MinorRadius result is initialized; tool does not discover a fillet relation.",
      "required": false
    },
    {
      "name": "needs_manual_review",
      "type": "boolean",
      "description": "Present when type/radius/association cannot be safely established.",
      "required": false
    },
    {
      "name": "reason",
      "type": "string",
      "description": "Manual-review reason when present.",
      "required": false
    }
  ],
  "postconditions": [
    "The action reads Torus.MinorRadius only and reports caller association status without inferring a Torus-to-fillet relation.",
    "Non-toroidal, unavailable, or unassociated cases remain needs_manual_review; no fillet creation/repair occurs."
  ],
  "implementation": {
    "mode": "spaceclaim_scscript",
    "primary_artifact": "spaceclaim-vision-modeling/assets/operation-templates/validation-visual-review/actions/va-15.scscript",
    "target_environment": "SpaceClaim V21 / IronPython 2.7 action wrapper with ATOMIC_INPUT/ATOMIC_OUTPUT; runtime execution remains not_tested in this candidate.",
    "topology_effect": "none",
    "determinism": "deterministic",
    "notes": "Candidate exact artifact is bound below; consult the exact-version evidence layers for tested variants. Adapt guidance toroidal_face/fillet_association to ATOMIC_INPUT={root, body, face, unit, fillet_relation?:...}; fillet_relation is a caller declaration, not a measured relation. The action measures Torus.MinorRadius only."
  },
  "semantic_selection": {
    "required": true,
    "criteria": [
      "geometry_type",
      "adjacency"
    ],
    "ambiguity_checks": [
      "Resolve the declared target from its supplied identity and semantic properties; do not use arbitrary BodyN/FaceN aliases or return order.",
      "If the target is not unique or the current topology/view cannot be observed, return needs_manual_review and do not continue."
    ],
    "topology_refresh": "Not applicable; this operation does not mutate model topology."
  },
  "failure_modes": [
    {
      "failure_id": "target_unresolved",
      "condition": "The declared target, scope, or view identity is missing or ambiguous.",
      "detection": "The supplied identity does not resolve to exactly one current target.",
      "safe_state": "No validation action is performed and no pass claim is emitted."
    },
    {
      "failure_id": "observation_unavailable",
      "condition": "The required API, host path, controller gesture, or visible state cannot be observed.",
      "detection": "The adapter or controller reports unsupported/blocked/unknown state.",
      "safe_state": "Preserve the current document/view and return needs_manual_review or not_tested."
    }
  ],
  "recovery": [
    {
      "failure_id": "target_unresolved",
      "action": "Strengthen the target identity or stop for manual review; do not substitute a numbered alias.",
      "clean_rerun_required": false
    },
    {
      "failure_id": "observation_unavailable",
      "action": "Use only a verified equivalent control/API or return needs_manual_review; do not repeat an unsupported gesture.",
      "clean_rerun_required": false
    }
  ],
  "validation": [
    {
      "check": "Candidate identity and schema shape",
      "method": "Validate this object against operation-template.schema.json and compare its operation ID with the catalog slug.",
      "expected": "The object is schema-valid, candidate-only, and declares one independent validation_visual_review action.",
      "evidence_layer": "design_only"
    },
