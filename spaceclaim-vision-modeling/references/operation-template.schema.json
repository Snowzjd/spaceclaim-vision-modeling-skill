{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Snowzjd/spaceclaim-vision-modeling-skill/blob/main/spaceclaim-vision-modeling/references/operation-template.schema.json",
  "title": "SpaceClaim vision modeling atomic operation template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "template_version",
    "contract_version",
    "status",
    "stage",
    "purpose",
    "trigger",
    "inputs",
    "preconditions",
    "outputs",
    "postconditions",
    "implementation",
    "semantic_selection",
    "failure_modes",
    "recovery",
    "validation",
    "dependencies",
    "evidence_level",
    "artifact_links"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^(geometry_understanding|modeling_strategy_scripting|execution_recovery|validation_visual_review)\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "template_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "contract_version": {
      "const": 1
    },
    "status": {
      "enum": ["candidate", "active", "deprecated"]
    },
    "stage": {
      "$ref": "#/$defs/stage"
    },
    "purpose": {
      "$ref": "#/$defs/non_empty_string"
    },
    "trigger": {
      "$ref": "#/$defs/non_empty_string"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "preconditions": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "output_schema": {
      "$ref": "#/$defs/file_binding"
    },
    "postconditions": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "implementation": {
      "$ref": "#/$defs/implementation"
    },
    "host_checker": {
      "$ref": "#/$defs/file_binding"
    },
    "semantic_selection": {
      "$ref": "#/$defs/semantic_selection"
    },
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/failure_mode"
      }
    },
    "recovery": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/recovery"
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/validation"
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(geometry_understanding|modeling_strategy_scripting|execution_recovery|validation_visual_review)\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    },
    "evidence_level": {
      "$ref": "#/$defs/evidence_level"
    },
    "artifact_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact_link"
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "stage": {
      "enum": [
        "geometry_understanding",
        "modeling_strategy_scripting",
        "execution_recovery",
        "validation_visual_review"
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required", "description"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "$ref": "#/$defs/non_empty_string"
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "$ref": "#/$defs/non_empty_string"
        },
        "provenance_required": {
          "type": "boolean"
        }
      }
    },
    "file_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:|/|\\\\|.*\\.\\./).+"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "primary_artifact",
        "target_environment",
        "topology_effect",
        "determinism"
      ],
      "properties": {
        "mode": {
          "enum": [
            "reasoning_guidance",
            "spaceclaim_scscript",
            "host_tool",
            "computer_use",
            "hybrid"
          ]
        },
        "primary_artifact": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(?![A-Za-z]:|/|\\\\|.*\\.\\./).+"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_environment": {
          "$ref": "#/$defs/non_empty_string"
        },
        "topology_effect": {
          "enum": ["none", "creates", "modifies", "deletes", "unknown"]
        },
        "determinism": {
          "enum": ["deterministic", "bounded_heuristic", "interactive"]
        },
        "notes": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "primary_artifact": {"type": "null"}
            },
            "required": ["primary_artifact"]
          },
          "then": {
            "required": ["notes"]
          }
        }
      ]
    },
    "semantic_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "criteria", "ambiguity_checks", "topology_refresh"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "criteria": {
          "type": "array",
          "items": {
            "enum": [
              "direction",
              "position",
              "normal",
              "area",
              "bounding_box",
              "volume",
              "geometry_type",
              "topology",
              "adjacency"
            ]
          },
          "uniqueItems": true
        },
        "ambiguity_checks": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "topology_refresh": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "failure_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_id", "condition", "detection", "safe_state"],
      "properties": {
        "failure_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "condition": {
          "$ref": "#/$defs/non_empty_string"
        },
        "detection": {
          "$ref": "#/$defs/non_empty_string"
        },
        "safe_state": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_id", "action", "clean_rerun_required"],
      "properties": {
        "failure_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "action": {
          "$ref": "#/$defs/non_empty_string"
        },
        "clean_rerun_required": {
          "type": "boolean"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "method", "expected", "evidence_layer"],
      "properties": {
        "check": {
          "$ref": "#/$defs/non_empty_string"
        },
        "method": {
          "$ref": "#/$defs/non_empty_string"
        },
        "expected": {
          "$ref": "#/$defs/non_empty_string"
        },
        "evidence_layer": {
          "$ref": "#/$defs/evidence_layer"
        }
      }
    },
    "evidence_level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_version", "layers"],
      "properties": {
        "template_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "layers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "design_only",
            "host_checked",
            "spaceclaim_execution",
            "geometry_measurements",
            "native_save",
            "native_reopen",
            "visual_review",
            "requested_export"
          ],
          "properties": {
            "design_only": {"$ref": "#/$defs/evidence_record"},
            "host_checked": {"$ref": "#/$defs/evidence_record"},
            "spaceclaim_execution": {"$ref": "#/$defs/evidence_record"},
            "geometry_measurements": {"$ref": "#/$defs/evidence_record"},
            "native_save": {"$ref": "#/$defs/evidence_record"},
            "native_reopen": {"$ref": "#/$defs/evidence_record"},
            "visual_review": {"$ref": "#/$defs/evidence_record"},
            "requested_export": {"$ref": "#/$defs/evidence_record"}
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_refs"],
      "properties": {
        "status": {
          "enum": ["passed", "failed", "not_tested", "not_applicable"]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"enum": ["passed", "failed"]}
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "evidence_refs": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {"enum": ["not_tested", "not_applicable"]}
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "evidence_refs": {"maxItems": 0}
            }
          }
        }
      ]
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:|/|\\\\|.*\\.\\./).+"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "evidence_layer": {
      "enum": [
        "design_only",
        "host_checked",
        "spaceclaim_execution",
        "geometry_measurements",
        "native_save",
        "native_reopen",
        "visual_review",
        "requested_export"
      ]
    },
    "artifact_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:|/|\\\\|.*\\.\\./).+"
        },
        "role": {
          "enum": [
            "template",
            "implementation",
            "evaluation",
            "editable_source",
            "reference",
            "test",
            "evidence"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    }
  }
}
