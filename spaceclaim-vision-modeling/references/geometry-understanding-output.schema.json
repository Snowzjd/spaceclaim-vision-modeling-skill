{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Snowzjd/spaceclaim-vision-modeling-skill/blob/main/spaceclaim-vision-modeling/references/geometry-understanding-output.schema.json",
  "title": "Geometry-understanding atomic operation output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_kind",
    "contract_version",
    "operation_id",
    "template_version",
    "handoff_status",
    "source_manifest_ref",
    "unresolved_items"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "contract_kind": {"const": "geometry_understanding_operation_output"},
    "contract_version": {"const": 1},
    "template_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "operation_id": {
      "enum": [
        "geometry_understanding.extract-geometry-observations",
        "geometry_understanding.reconcile-dimensions",
        "geometry_understanding.define-coordinate-frame"
      ]
    },
    "handoff_status": {
      "enum": ["draft", "requires_clarification", "ready", "passed", "failed", "not_tested"]
    },
    "source_manifest_ref": {"$ref": "#/$defs/non_empty_string"},
    "observed_geometry": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/provenance_item"}
    },
    "bodies_and_features": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/provenance_item"}
    },
    "spatial_relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation_item"}
    },
    "symmetry_and_repetition": {
      "type": "array",
      "items": {"$ref": "#/$defs/provenance_item"}
    },
    "confidence": {"$ref": "#/$defs/confidence"},
    "dimensions_with_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dimension_item"}
    },
    "dimension_relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/dimension_relation"}
    },
    "reconciliation_confidence": {"$ref": "#/$defs/confidence"},
    "coordinate_system": {"$ref": "#/$defs/coordinate_system"},
    "frame_assumptions": {
      "type": "array",
      "items": {"$ref": "#/$defs/provenance_item"}
    },
    "frame_confidence": {"$ref": "#/$defs/confidence"},
    "unresolved_items": {
      "type": "array",
      "items": {"$ref": "#/$defs/unresolved_item"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation_id": {"const": "geometry_understanding.extract-geometry-observations"}
        },
        "required": ["operation_id"]
      },
      "then": {
        "required": [
          "observed_geometry",
          "bodies_and_features",
          "spatial_relations",
          "symmetry_and_repetition",
          "confidence"
        ],
        "not": {
          "anyOf": [
            {"required": ["dimensions_with_provenance"]},
            {"required": ["dimension_relations"]},
            {"required": ["reconciliation_confidence"]},
            {"required": ["coordinate_system"]},
            {"required": ["frame_assumptions"]},
            {"required": ["frame_confidence"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_id": {"const": "geometry_understanding.reconcile-dimensions"}
        },
        "required": ["operation_id"]
      },
      "then": {
        "required": [
          "dimensions_with_provenance",
          "dimension_relations",
          "reconciliation_confidence"
        ],
        "not": {
          "anyOf": [
            {"required": ["observed_geometry"]},
            {"required": ["bodies_and_features"]},
            {"required": ["spatial_relations"]},
            {"required": ["symmetry_and_repetition"]},
            {"required": ["confidence"]},
            {"required": ["coordinate_system"]},
            {"required": ["frame_assumptions"]},
            {"required": ["frame_confidence"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_id": {"const": "geometry_understanding.define-coordinate-frame"}
        },
        "required": ["operation_id"]
      },
      "then": {
        "required": ["coordinate_system", "frame_assumptions", "frame_confidence"],
        "not": {
          "anyOf": [
            {"required": ["observed_geometry"]},
            {"required": ["bodies_and_features"]},
            {"required": ["spatial_relations"]},
            {"required": ["symmetry_and_repetition"]},
            {"required": ["confidence"]},
            {"required": ["dimensions_with_provenance"]},
            {"required": ["dimension_relations"]},
            {"required": ["reconciliation_confidence"]}
          ]
        }
      }
    }
  ],
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator", "modality"],
      "properties": {
        "source_id": {"$ref": "#/$defs/non_empty_string"},
        "locator": {"$ref": "#/$defs/non_empty_string"},
        "modality": {
          "enum": ["image", "drawing", "cad_view", "text", "user_input", "model", "script", "log", "other"]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_refs"],
      "properties": {
        "kind": {"enum": ["observation", "user", "inference", "unresolved"]},
        "source_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/source_ref"}
        },
        "rationale": {"$ref": "#/$defs/non_empty_string"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["observation", "user"]}}, "required": ["kind"]},
          "then": {"properties": {"source_refs": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"kind": {"enum": ["inference", "unresolved"]}}, "required": ["kind"]},
          "then": {"required": ["rationale"]}
        }
      ]
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "coverage", "rationale"],
      "properties": {
        "level": {"enum": ["high", "medium", "low", "unknown"]},
        "coverage": {"enum": ["complete", "partial", "insufficient"]},
        "rationale": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "provenance_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "provenance", "confidence"],
      "properties": {
        "id": {"$ref": "#/$defs/non_empty_string"},
        "statement": {"$ref": "#/$defs/non_empty_string"},
        "category": {"$ref": "#/$defs/non_empty_string"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "confidence": {"enum": ["high", "medium", "low", "unknown"]}
      }
    },
    "relation_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relation", "participant_refs", "provenance", "confidence"],
      "properties": {
        "id": {"$ref": "#/$defs/non_empty_string"},
        "relation": {"$ref": "#/$defs/non_empty_string"},
        "participant_refs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/non_empty_string"}
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "confidence": {"enum": ["high", "medium", "low", "unknown"]}
      }
    },
    "unresolved_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "reason", "blocks_handoff", "clarification_needed", "source_refs", "related_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/non_empty_string"},
        "description": {"$ref": "#/$defs/non_empty_string"},
        "reason": {"enum": ["missing", "conflicting", "occluded", "ambiguous", "unsupported", "other"]},
        "blocks_handoff": {"type": "boolean"},
        "clarification_needed": {"$ref": "#/$defs/non_empty_string"},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/source_ref"}},
        "related_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/non_empty_string"}}
      }
    },
    "dimension_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target_ref", "disposition", "value", "unit", "provenance", "supporting_statement_refs", "confidence"],
      "properties": {
        "id": {"$ref": "#/$defs/non_empty_string"},
        "target_ref": {"$ref": "#/$defs/non_empty_string"},
        "disposition": {"enum": ["accepted", "derived", "conflicting", "unresolved"]},
        "value": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"]},
        "tolerance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lower", "upper"],
          "properties": {"lower": {"type": "number"}, "upper": {"type": "number"}}
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "supporting_statement_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/non_empty_string"}
        },
        "derivation": {"$ref": "#/$defs/non_empty_string"},
        "confidence": {"enum": ["high", "medium", "low", "unknown"]}
      }
    },
    "dimension_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relation_type", "operand_refs", "expression", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/non_empty_string"},
        "relation_type": {"enum": ["equality", "difference", "ratio", "dependency", "reference"]},
        "operand_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/non_empty_string"}
        },
        "expression": {"$ref": "#/$defs/non_empty_string"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "frame_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "provenance"],
      "properties": {
        "status": {"enum": ["resolved", "unresolved"]},
        "value": {
          "oneOf": [
            {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false, "minItems": 3, "maxItems": 3},
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "coordinate_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "x_axis", "y_axis", "z_axis", "handedness", "unit_context", "source_view_mapping"],
      "properties": {
        "origin": {"$ref": "#/$defs/frame_component"},
        "x_axis": {"$ref": "#/$defs/frame_component"},
        "y_axis": {"$ref": "#/$defs/frame_component"},
        "z_axis": {"$ref": "#/$defs/frame_component"},
        "handedness": {"$ref": "#/$defs/frame_component"},
        "unit_context": {"$ref": "#/$defs/frame_component"},
        "source_view_mapping": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_ref", "mapping", "provenance"],
            "properties": {
              "source_ref": {"$ref": "#/$defs/source_ref"},
              "mapping": {"$ref": "#/$defs/non_empty_string"},
              "provenance": {"$ref": "#/$defs/provenance"}
            }
          }
        }
      }
    }
  }
}
