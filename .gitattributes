* text=auto

*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.csv text eol=lf

*.scscript binary
*.scdoc binary
*.step binary
*.stp binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary

# These resources and test sources are referenced by exact SHA-256 digests.
# Preserve their bytes across checkout instead of rewriting line endings.
spaceclaim-vision-modeling/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
tests/** -text whitespace=trailing-space,space-before-tab,cr-at-eol

# Raw runtime reports retain the originating writer's whitespace as evidence.
spaceclaim-vision-modeling/assets/evaluations/**/report.json -whitespace
spaceclaim-vision-modeling/assets/evaluations/p4-actions/save-report.json -whitespace
